# ==============================================================
# ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your values.
# DO NOT COMMIT REAL SECRETS OR DATABASE CREDENTIALS TO GIT.
# ==============================================================

# Application Configuration
APP_NAME="User Management API"
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=True

# Database Configuration (PostgreSQL with Psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/user_management_db

# Security & JWT Authentication
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace_with_a_long_random_secret_minimum_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Password Reset Configuration
PASSWORD_RESET_EXPIRE_MINUTES=15
